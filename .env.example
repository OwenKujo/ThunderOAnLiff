# Core application
APP_NAME=ThunderOAnLiff
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Use a unique random secret with at least 32 characters in each environment
JWT_SECRET=replace_this_with_a_random_secret_of_at_least_32_characters
ADMIN_SESSION_TTL=8h

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thunder_oan_liff?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/thunder_oan_liff?schema=public

# LINE Messaging API / LINE Login (leave blank until the LINE channels are configured)
# LIFF_CHANNEL_ID is the LINE Login channel ID used to verify LIFF ID tokens
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_CHANNEL_ID=
VITE_LIFF_ID=
VITE_API_BASE_URL=http://localhost:3001/api

# Initial admin bootstrap: do not use these weak defaults in production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_chars
